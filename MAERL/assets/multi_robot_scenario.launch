<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="map_name" default="trainenv" />
  <arg name="map_path" default="$(find gazebo_ros_2dmap_plugin)/maps/$(arg map_name)/map.yaml" />

  <param name="map_name" value="$(arg map_name)" />

  <!-- Map server -->
  <include file="$(find multi_robot_scenario)/launch/map_server.launch">
    <arg name="map_path" value="$(arg map_path)" />
  </include>

  <!-- Fake static transform map_to_odom -->
  <include file="$(find multi_robot_scenario)/launch/fake_localization.launch">
    <arg name="odom_frame_id" value="odom" />
    <arg name="global_frame_id" value="map" />
  </include>

  <!-- Gazebo  -->
  <include file="$(find multi_robot_scenario)/launch/empty_world.launch">
    <arg name="gui" default="false" />
    <arg name="world_name" default="$(arg map_name).world" />
  </include>

  <!-- Robot with diff drive -->
  <include file="$(find multi_robot_scenario)/launch/pioneer3dx.gazebo.launch">
     <arg name="robot_name" value="r1" />
     <arg name="robot_position" value="-x 2.0 -y 0.0 -z 0.01 -R 0 -P 0 -Y +0.0" />
  </include>

  <!-- RVIZ -->
  <!-- <node pkg="rviz" type="rviz" name="rviz" args="-d $(find multi_robot_scenario)/launch/pioneer3dx.rviz" /> -->

</launch>
